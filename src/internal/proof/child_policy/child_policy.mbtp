///|
fn policy_rank(p : PolicyLevel) -> Int {
  match p {
    Parallel => 0
    Sequential => 1
    Exclusive => 2
  }
}

///|
predicate exists_child_upto(
  pending_parents : FixedArray[Int],
  upto : Int,
  target_parent : Int,
) {
  ∃ k : Int, 0 <= k && k < upto && pending_parents[k] == target_parent
}
