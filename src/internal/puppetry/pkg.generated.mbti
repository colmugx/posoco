pub(open) trait Mailbox {
  fn bind_run(Self, @kernel.RunId, @kernel.TurnId) -> Unit
  fn clear_run(Self) -> Unit
  fn active_run_id(Self) -> @kernel.RunId?
  fn active_turn_id(Self) -> @kernel.TurnId?
  fn abort_requested(Self) -> Bool
  fn steer_depth(Self) -> Int
  fn follow_up_depth(Self) -> Int
  fn fork_depth(Self) -> Int
  fn compact_depth(Self) -> Int
  fn enqueue_steer(Self, SteerCommand) -> EnqueueResult
  fn enqueue_follow_up(Self, FollowUpCommand) -> EnqueueResult
  fn enqueue_resume(Self, ResumeCommand) -> EnqueueResult
  fn enqueue_abort(Self, AbortCommand) -> EnqueueResult
  fn enqueue_fork(Self, ForkCommand) -> EnqueueResult
  fn enqueue_compact(Self, CompactCommand) -> EnqueueResult
  fn consume_steers(Self) -> Array[SteerCommand]
  fn consume_one_follow_up(Self) -> FollowUpCommand?
  fn consume_one_fork(Self) -> ForkCommand?
  fn consume_one_compact(Self) -> CompactCommand?
  fn take_resume(Self, String) -> ResumeCommand?
  fn quiescent_status(Self) -> QuiescentStatus
  fn set_quiescent(Self, QuiescentStatus) -> Unit
  async fn wait_idle(Self) -> QuiescentStatus
}

