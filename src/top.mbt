  type StreamAccumulator,
  type Usage,
  type MemoryEntry,
  type MemoryQuery,
  type FinishReason,
  type ReasoningEffort,
  type ToolChoice,
}

///|
// Core port traits.
pub using @port {
  trait ModelPort,
  trait ToolProvider,
  trait SessionStore,
  trait Observer,
  trait Compressor,
  trait PipelineHook,
  trait MemoryPort,
  trait Lifecycle,
  trait CommandPort,
  trait UiPort,
  trait SystemPromptContributor,
  // Self-reporting manifest protocol.
  trait Extension,
  // Port-related enums.
  type Stage,
  type HookError,
  type CompressAction,
  type CommandOutcome,
  type CommandType,
  type CommandParam,
  type ParamType,
  type UiHint,
  type UiSlot,
  type UiBody,
  type UiRequest,
  type UiResponse,
  // Port-related structs.
  type CompressContext,
  type CommandDef,
  type AutocompleteItem,
  type AutocompleteSource,
  type UiDescriptor,
  type UiRender,
  type SystemPromptHook,
  type SystemPromptSection,
  type ExtensionManifest,
  // Builtin UiPort impls (testkit-grade, also used by hosts without a UI).
  type NoopUiPort,
  type CompositeUiPort,
}

