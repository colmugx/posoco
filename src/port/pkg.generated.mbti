// Type aliases
pub type ToolRetire = async () -> Result[Unit, String]

pub type UiActionHandler = async (UiActionInvocation) -> Result[Unit, String]

// Traits
pub(open) trait CommandPort {
  fn commands(Self) -> Array[CommandDef]
  async fn invoke(Self, String, @json.Json) -> CommandOutcome raise @error.CommandError
}

pub(open) trait DecisionPort {
  async fn evaluate(Self, DecisionRequest, context~ : DecisionCallContext) -> DecisionResult raise @error.DecisionError
}

pub(open) trait Extension {
  fn extension_id(Self) -> String
  fn manifest(Self) -> ExtensionManifest
}

pub(open) trait Lifecycle {
  fn on_compose(Self, CompositionView) -> Unit raise @error.CompositionError = _
  async fn on_start(Self) -> Unit = _
  async fn on_shutdown(Self) -> Unit = _
}

pub(open) trait LogPort {
  async fn write(Self, LogRecord, LogDurability) -> Unit raise @error.LogError
  async fn flush(Self) -> Unit raise @error.LogError
}

pub(open) trait MemoryPort {
  async fn inbound(Self, session_id~ : String, request~ : String) -> String? raise @error.MemoryError
  async fn store(Self, content~ : String, metadata~ : Map[String, @json.Json]) -> String raise @error.MemoryError
  async fn search(Self, query~ : String, top_k? : Int32) -> String? raise @error.MemoryError
  async fn delete(Self, String) -> Unit raise @error.MemoryError
}

pub(open) trait ModelPort {
  async fn chat(Self, @kernel.InvocationScope, ArrayView[@kernel.Message], Array[@kernel.ToolDef], @types.ChatOptions, @types.StreamMode) -> @kernel.ModelCallResult raise @error.ModelError
  async fn compact(Self, @kernel.InvocationScope, ArrayView[@kernel.Message], Array[@kernel.ToolDef], @types.ChatOptions, @kernel.CompactTrigger) -> @kernel.CompactResult raise @error.ModelError
  fn provider_config(Self) -> ProviderConfig
}

pub(open) trait Observer {
  fn on_event(Self, @types.EventScope?, @types.TurnEvent) -> Unit = _
}

pub(open) trait PipelineHook {
  fn tool_exposure(Self, @kernel.ToolDef) -> @kernel.ToolExposure = _
  async fn before_model(Self, Array[@kernel.Message]) -> Array[@kernel.Message] raise HookAbort = _
  async fn before_tool(Self, @kernel.ToolCall) -> ToolDecision = _
  async fn on_post_event(Self, @types.EventScope?, HookStage) -> Unit noraise = _
  async fn on_turn_begin(Self) -> Unit = _
  async fn on_turn_end(Self) -> Unit = _
}

pub(open) trait SessionPort {
  async fn load(Self, String) -> @types.Session raise @error.SessionError
  async fn save(Self, String, @types.Session) -> Unit raise @error.SessionError
  async fn append_messages(Self, String, Int32, ArrayView[@kernel.Message]) -> Unit raise @error.SessionError = _
  async fn checkpoint(Self, String, SessionCheckpoint) -> Unit raise @error.SessionError = _
  async fn truncate(Self, String, Int32) -> Unit raise @error.SessionError = _
}

pub(open) trait SystemPromptContributor {
  fn system_prompt(Self) -> String
}

pub(open) trait ToolCancellable {
  async fn cancel(Self, run_id~ : @kernel.RunId, @kernel.EffectId, @kernel.CancelReason) -> @kernel.CancelDisposition
}

pub(open) trait ToolProvider {
  fn list_tools(Self) -> Array[@kernel.ToolDef]
  async fn execute(Self, ToolCallContext) -> @kernel.ToolOutcome raise @error.RuntimeError
}

pub(open) trait UiPort {
  fn ui_descriptor(Self) -> UiDescriptor
  fn render(Self, UiRender) -> Unit
  async fn request(Self, UiRequest) -> UiResponse raise @error.UiError
}
